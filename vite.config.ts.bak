import { defineConfig, loadEnv, type Plugin } from 'vite'
import react from '@vitejs/plugin-react'
import fs from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import type { IncomingMessage, ServerResponse } from 'node:http'
import { demoReply } from './server/assistant'

const root = path.dirname(fileURLToPath(import.meta.url))

async function readBody(req: IncomingMessage): Promise<string> {
  const chunks: Buffer[] = []
  for await (const chunk of req) chunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk))
  return Buffer.concat(chunks).toString('utf8')
}

function send(res: ServerResponse, status: number, body: unknown, headers: Record<string, string> = {}) {
  const json = JSON.stringify(body)
  res.statusCode = status
  res.setHeader('Content-Type', 'application/json')
  for (const [k, v] of Object.entries(headers)) res.setHeader(k, v)
  res.end(json)
}

function readLocale(name: string): Record<string, unknown> {
  try {
    return JSON.parse(fs.readFileSync(path.join(root, 'src', 'i18n', 'locales', `${name}.json`), 'utf8')) as Record<string, unknown>
  } catch {
    return {}
  }
}

function mergeLocale(base: Record<string, unknown>, extra: Record<string, unknown>): Record<string, unknown> {
  const out: Record<string, unknown> = { ...base }
  for (const [key, value] of Object.entries(extra)) {
    if (value && typeof value === 'object' && !Array.isArray(value) && out[key] && typeof out[key] === 'object') {
      out[key] = mergeLocale(out[key] as Record<string, unknown>, value as Record<string, unknown>)
    } else {
      out[key] = value
    }
  }
  return out
}

function localePack(lang: string): Record<string, unknown> {
  const safe = /^[a-z]{2}(-[A-Z]{2})?$/.test(lang) ? lang : 'en'
  return mergeLocale(readLocale('en'), safe === 'en' ? {} : readLocale(safe))
}

function stripFlags(text: string) {
  let refused = false
  let escalated = false
  let fraud = false
  let reply = text
  const pull = (token: string, flag: 'refused' | 'escalated' | 'fraud') => {
    if (reply.includes(token)) {
      if (flag === 'refused') refused = true
      if (flag === 'escalated') escalated = true
      if (flag === 'fraud') fraud = true
      reply = reply.replaceAll(token, '')
    }
  }
  pull('[[FRAUD]]', 'fraud')
  pull('[[ESCALATE]]', 'escalated')
  pull('[[REFUSE]]', 'refused')
  return { reply: reply.trim(), refused, escalated, fraud }
}

function apiPlugin(): Plugin {
  const handler = async (req: IncomingMessage, res: ServerResponse) => {
    const url = req.url?.split('?')[0] ?? ''
    if (!url.startsWith('/api/')) return false
    try {
      if (url === '/api/chat' && req.method === 'POST') {
        const env = loadEnv(process.env.NODE_ENV === 'production' ? 'production' : 'development', root, '')
        const raw = JSON.parse((await readBody(req)) || '{}') as {
          messages?: { role: 'user' | 'assistant'; content: string }[]
          language?: string
          languageName?: string
          detail?: 'short' | 'full'
          screen?: string
          step?: string
        }
        const messages = Array.isArray(raw.messages) ? raw.messages.slice(-8) : []
        const last = messages.filter((m) => m.role === 'user').at(-1)?.content ?? ''
        const pack = localePack(raw.language || 'en')
        const userTurns = messages.filter((m) => m.role === 'user').length
        const secret = /password|\botp\b|\bpin\b|full card|card number|\d{13,}/i.test(last)
        if (secret) {
          const safety = demoReply(pack, {
            message: last,
            detail: raw.detail === 'short' ? 'short' : 'full',
            screen: raw.screen || 'app',
            userTurns,
          })
          send(res, 200, safety)
          return true
        }
        const key = env.OPENAI_API_KEY
        if (!key) {
          send(res, 200, demoReply(pack, {
            message: last,
            detail: raw.detail === 'short' ? 'short' : 'full',
            screen: raw.screen || 'app',
            userTurns,
          }))
          return true
        }
        const detailLine = raw.detail === 'short' ? 'short and simple' : 'full detail'
        const system = [
          'You are the OCBC Adaptive in-app banking assistant in a demo app. Only help with banking and using this app: accounts, transfers, PayNow, GIRO, bills, cards, savings, fees, security and scams, and the current screen.',
          `Reply in ${raw.languageName || 'English'}, ${detailLine} detail, in plain friendly words, explaining banking terms simply.`,
          'If a question is not about banking or this app, politely say you can only help with banking and suggest what you can do.',
          'Never ask for or reveal passwords, OTPs, PINs or full card numbers.',
          "Never invent account data, rates or fees; say you're not sure and offer to contact staff.",
          "Offer 'Guide me step by step' when the user wants to do a task.",
          'Suggest contacting staff when the user asks for a person, is still stuck after two tries, or mentions fraud, scams, disputes or a lost card.',
          'For suspected fraud or a lost card, also show the 24-hour hotline +65 6363 3333 and the option to lock the card immediately.',
          `Current screen: ${raw.screen || 'unknown'}. Current step: ${raw.step || 'none'}.`,
          'This is a prototype. Balances are samples. Do not pretend a payment was sent to a real bank.',
          'If you refuse an off-topic question, start with [[REFUSE]]. If you escalate to a person, start with [[ESCALATE]]. If this is fraud, a scam, a dispute or a lost card, start with [[FRAUD]]. Then write the customer-facing reply. Do not mention these markers.',
        ].join(' ')
        const base = (env.OPENAI_BASE_URL || 'https://api.openai.com/v1').replace(/\/$/, '')
        const model = env.OPENAI_MODEL || 'gpt-4o-mini'
        try {
          const upstream = await fetch(`${base}/chat/completions`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Authorization: `Bearer ${key}`,
            },
            body: JSON.stringify({
              model,
              temperature: 0.4,
              messages: [{ role: 'system', content: system }, ...messages.map((m) => ({ role: m.role, content: String(m.content).slice(0, 2000) }))],
            }),
          })
          if (!upstream.ok) throw new Error(`upstream ${upstream.status}`)
          const data = (await upstream.json()) as { choices?: { message?: { content?: string } }[] }
          const text = data.choices?.[0]?.message?.content || ''
          const flags = stripFlags(text)
          send(res, 200, { reply: flags.reply, source: 'llm', flags: { refused: flags.refused, escalated: flags.escalated, fraud: flags.fraud } })
        } catch {
          const fallback = demoReply(pack, {
            message: last,
            detail: raw.detail === 'short' ? 'short' : 'full',
            screen: raw.screen || 'app',
            userTurns,
          })
          fallback.reply = `${fallback.reply}\n\n${readPath(pack, 'ai.liveFailed') || 'The live assistant could not be reached, so this is a built-in demo answer.'}`
          send(res, 200, fallback)
        }
        return true
      }
      if (url === '/api/tts' && req.method === 'POST') {
        const env = loadEnv(process.env.NODE_ENV === 'production' ? 'production' : 'development', root, '')
        const raw = JSON.parse((await readBody(req)) || '{}') as { text?: string; lang?: string; rate?: number; dialect?: string }
        const text = String(raw.text || '').slice(0, 1200)
        if (!text) {
          send(res, 400, { error: 'missing text' })
          return true
        }
        const rate = Math.min(1.6, Math.max(0.7, Number(raw.rate) || 1))
        const cantonese = raw.dialect === 'cantonese'
        const googleKey = env.GOOGLE_TTS_API_KEY
        if (googleKey) {
          const languageCode = cantonese ? 'yue-HK' : (raw.lang || 'en-SG')
          const voiceName = cantonese ? 'yue-HK-Standard-A' : undefined
          const upstream = await fetch(`https://texttospeech.googleapis.com/v1/text:synthesize?key=${googleKey}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              input: { text },
              voice: voiceName ? { languageCode, name: voiceName } : { languageCode },
              audioConfig: { audioEncoding: 'MP3', speakingRate: rate },
            }),
          })
          const data = (await upstream.json()) as { audioContent?: string }
          if (upstream.ok && data.audioContent) {
            send(res, 200, { audio: data.audioContent, provider: 'google' })
            return true
          }
        }
        const azureKey = env.AZURE_SPEECH_KEY
        const region = env.AZURE_SPEECH_REGION || 'southeastasia'
        if (azureKey) {
          const voice = cantonese ? 'zh-HK-HiuMaanNeural' : azureVoice(raw.lang || 'en-SG')
          const ssml = `<speak version='1.0' xml:lang='${cantonese ? 'zh-HK' : raw.lang || 'en-SG'}'><voice name='${voice}'><prosody rate='${rate}'>${escapeXml(text)}</prosody></voice></speak>`
          const upstream = await fetch(`https://${region}.tts.speech.microsoft.com/cognitiveservices/v1`, {
            method: 'POST',
            headers: {
              'Ocp-Apim-Subscription-Key': azureKey,
              'Content-Type': 'application/ssml+xml',
              'X-MICROSOFT-OutputFormat': 'audio-16khz-128kbitrate-mono-mp3',
            },
            body: ssml,
          })
          if (upstream.ok) {
            const buf = Buffer.from(await upstream.arrayBuffer())
            send(res, 200, { audio: buf.toString('base64'), provider: 'azure' })
            return true
          }
        }
        send(res, 501, { error: 'no tts configured' })
        return true
      }
      send(res, 404, { error: 'not found' })
      return true
    } catch (error) {
      send(res, 500, { error: error instanceof Error ? error.message : 'error' })
      return true
    }
  }

  const attach = (middlewares: { use: (fn: (req: IncomingMessage, res: ServerResponse, next: () => void) => void) => void }) => {
    middlewares.use((req, res, next) => {
      void handler(req, res).then((handled) => {
        if (!handled) next()
      })
    })
  }

  return {
    name: 'ocbc-api',
    configureServer(server) {
      attach(server.middlewares)
    },
    configurePreviewServer(server) {
      attach(server.middlewares)
    },
  }
}

function escapeXml(s: string) {
  return s.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
}

function azureVoice(lang: string) {
  const map: Record<string, string> = {
    'en-SG': 'en-SG-LunaNeural',
    'zh-CN': 'zh-CN-XiaoxiaoNeural',
    'zh-TW': 'zh-TW-HsiaoChenNeural',
    'ms-MY': 'ms-MY-YasminNeural',
    'ta-IN': 'ta-IN-PallaviNeural',
    'id-ID': 'id-ID-GadisNeural',
    'vi-VN': 'vi-VN-HoaiMyNeural',
    'th-TH': 'th-TH-PremwadeeNeural',
    'fil-PH': 'fil-PH-BlessicaNeural',
    'ko-KR': 'ko-KR-SunHiNeural',
    'ja-JP': 'ja-JP-NanamiNeural',
    'hi-IN': 'hi-IN-SwaraNeural',
    'bn-IN': 'bn-IN-TanishaaNeural',
  }
  return map[lang] || 'en-SG-LunaNeural'
}

function readPath(obj: Record<string, unknown>, pathStr: string): string | undefined {
  const parts = pathStr.split('.')
  let cur: unknown = obj
  for (const p of parts) {
    if (!cur || typeof cur !== 'object') return undefined
    cur = (cur as Record<string, unknown>)[p]
  }
  return typeof cur === 'string' ? cur : undefined
}

export default defineConfig({
  plugins: [react(), apiPlugin()],
  resolve: {
    alias: { '@': path.join(root, 'src') },
  },
  server: { port: 5173, host: '127.0.0.1' },
})
