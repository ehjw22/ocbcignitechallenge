    "html-to-image": "^1.11.13",
    "lucide-react": "^0.503.0",
    "openai": "^7.43.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.5.3",
    "recharts": "^2.15.3",
    "remark-breaks": "^4.0.0",
    "zod": "^4.6.7"
